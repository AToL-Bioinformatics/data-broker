# ENA Webin credentials
# Get these from https://www.ebi.ac.uk/ena/submit/webin/login
WEBIN_USERNAME=Webin-XXXXX
WEBIN_PASSWORD=your-webin-password

# ENA submission endpoints
# The broker uses ENA_DEV_BASE_URL by default and switches to ENA_PROD_BASE_URL with --prod.
ENA_DEV_BASE_URL=https://wwwdev.ebi.ac.uk/ena/submit/drop-box/submit/
ENA_PROD_BASE_URL=https://www.ebi.ac.uk/ena/submit/drop-box/submit/

# Canopy API
CANOPY_BASE_URL=http://localhost:8000/api/v1
CANOPY_USERNAME=<username>
CANOPY_PASSWORD=<password>

# Storage directories (defaults shown; override as needed)
# BROKER_STATE_DIR=~/.broker/state
# BROKER_RECEIPT_DIR=~/.broker/receipts

# HTTP configuration (defaults shown)
# HTTP_TIMEOUT_SECONDS=30.0
# HTTP_MAX_RETRIES=3
# HTTP_RETRY_MIN_WAIT=1.0
# HTTP_RETRY_MAX_WAIT=30.0

# ToLID API
# The broker uses TOLID_DEV_BASE_URL by default and switches to TOLID_PROD_BASE_URL with --prod.
TOLID_DEV_BASE_URL=https://id-staging.tol.sanger.ac.uk
TOLID_PROD_BASE_URL=https://id.tol.sanger.ac.uk
# TOLID_API_KEY=your-tolid-api-key
